<?xml version="1.0"?>
<!--
  diffbot 用の練習ワールド (Gazebo Fortress)
    - 10m x 10m の壁で囲まれたアリーナ
    - 障害物 (箱・円柱) : 3D LiDAR / 前方カメラの確認用
    - 床の黒いライン    : 下向きカメラ (ライントレース) の確認用
-->
<sdf version="1.8">
  <world name="diffbot_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ワールドに必須のシステムプラグイン -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- カメラ・LiDAR などのレンダリングセンサを動かす -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU センサを動かす -->
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <!-- 影を切る: 下向きカメラに車体の影が映り込むのを防ぐ -->
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===== 地面 ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 床のライン (見た目のみ, 当たり判定なし) =====
         長方形ループ: x = -1.5 ~ 2.5, y = 0 ~ 2 。ロボットは原点 (下辺の上) からスタート -->
    <model name="line_track">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="bottom">
          <pose>0.5 0 0 0 0 0</pose>
          <geometry><box><size>4.05 0.05 0.002</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="top">
          <pose>0.5 2 0 0 0 0</pose>
          <geometry><box><size>4.05 0.05 0.002</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="left">
          <pose>-1.5 1 0 0 0 0</pose>
          <geometry><box><size>0.05 2.05 0.002</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="right">
          <pose>2.5 1 0 0 0 0</pose>
          <geometry><box><size>0.05 2.05 0.002</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 外壁 (10m x 10m, 高さ 1m) ===== -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>0 5 0.5 0 0 0</pose><geometry><box><size>10.2 0.1 1</size></box></geometry></collision>
        <visual name="north_v"><pose>0 5 0.5 0 0 0</pose><geometry><box><size>10.2 0.1 1</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -5 0.5 0 0 0</pose><geometry><box><size>10.2 0.1 1</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -5 0.5 0 0 0</pose><geometry><box><size>10.2 0.1 1</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
        <collision name="east_c"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.1 10.2 1</size></box></geometry></collision>
        <visual name="east_v"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.1 10.2 1</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
        <collision name="west_c"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.1 10.2 1</size></box></geometry></collision>
        <visual name="west_v"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.1 10.2 1</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== 障害物 ===== -->
    <model name="red_box">
      <static>true</static>
      <pose>3.5 -2 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="green_box">
      <static>true</static>
      <pose>-2.5 -3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.4 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.4 0.8</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="yellow_cylinder">
      <static>true</static>
      <pose>1 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="blue_cylinder">
      <static>true</static>
      <pose>-3.5 2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.9 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="purple_box">
      <static>true</static>
      <pose>4 3.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.6 0.1 0.7 1</ambient><diffuse>0.6 0.1 0.7 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
