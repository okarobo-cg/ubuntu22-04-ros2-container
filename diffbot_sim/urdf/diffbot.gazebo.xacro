<?xml version="1.0"?>
<!--
  Gazebo (Fortress / ign-gazebo 6) 用の設定
    - センサ: 3D LiDAR, 前方カメラ, 下向きカメラ, IMU
    - プラグイン: DiffDrive (差動二輪制御), JointStatePublisher

  ここで設定した Gazebo 側のトピック名は config/bridge.yaml で ROS 2 のトピックに変換される。
  ※ Fortress では frame_id の指定に <ignition_frame_id> を使う (Garden 以降は <gz_frame_id>)。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 色 (Gazebo 描画用) -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.1 0.3 0.8 1</ambient>
        <diffuse>0.1 0.3 0.8 1</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- ============ 差動二輪コントローラ ============ -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- 入力: 速度指令 / 出力: オドメトリと TF -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/model/diffbot/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>

      <!-- 加速度・速度の制限 -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
    </plugin>

    <!-- 車輪の関節角度を publish (RViz で車輪が回るのに必要) -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ============ 3D LiDAR (16ch, VLP-16 風) ============ -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_3d" type="gpu_lidar">
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <!-- /lidar (LaserScan) と /lidar/points (PointCloud2) が出る -->
      <topic>/lidar</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-PI}</min_angle>
            <max_angle>${PI}</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>${-15*PI/180}</min_angle>
            <max_angle>${15*PI/180}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ============ 前方カメラ ============ -->
  <gazebo reference="front_camera_link">
    <sensor name="front_camera" type="camera">
      <ignition_frame_id>front_camera_optical_frame</ignition_frame_id>
      <!-- /front_camera/image と /front_camera/camera_info が出る -->
      <topic>/front_camera/image</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3963</horizontal_fov> <!-- 80 deg -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ============ 下向きカメラ (ライントレースなど用) ============ -->
  <gazebo reference="down_camera_link">
    <sensor name="down_camera" type="camera">
      <ignition_frame_id>down_camera_optical_frame</ignition_frame_id>
      <topic>/down_camera/image</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov> <!-- 90 deg -->
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ============ IMU ============ -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <ignition_frame_id>imu_link</ignition_frame_id>
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

</robot>
